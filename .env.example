# Supabase project URL, for example https://xxxx.supabase.co
SUPABASE_URL=

# Server-only service_role / secret key from Supabase → Settings → API.
# Do not use the anon or publishable key. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Resend notification after a successful RSVP save.
RESEND_API_KEY=
RSVP_NOTIFICATION_EMAIL=
RSVP_FROM_EMAIL=
